# Local Docker configuration. Never commit your real .env file.
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
APP_PORT=8000

DB_USER=tavliqo
DB_PASSWORD=CHANGE_ME_use_a_unique_password
CONTROL_DB_NAME=tavliqo_control
TENANT_DB_NAME=tavliqo_tenant

# Docker service names are used from inside the web container.
CONTROL_DATABASE_URL=postgres://tavliqo:CHANGE_ME_use_a_unique_password@control-db:5432/tavliqo_control
TENANT_DATABASE_URL=postgres://tavliqo:CHANGE_ME_use_a_unique_password@tenant-db:5432/tavliqo_tenant

# Optional Cloudinary media storage. Leave blank for local Docker media volume.
CLOUDINARY_URL=


# ─── Super Admin Seed Data ────────────────────────────────────────────
# Used to create the first super admin accounts
SUPERADMIN1_EMAIL=admin@tavliqo.com
SUPERADMIN1_PASSWORD=AdminPass123!

SUPERADMIN2_EMAIL=backup@tavliqo.com
SUPERADMIN2_PASSWORD=BackupPass123!